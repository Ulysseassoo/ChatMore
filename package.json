{
	"name": "chatmore",
	"version": "1.0.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:test": "supabase test db",
		"db:types": "supabase gen types typescript --local > src/lib/database.types.ts && prettier --write src/lib/database.types.ts",
		"lint": "eslint . && prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
		"typecheck": "tsc --noEmit",
		"test:e2e": "playwright test",
		"format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\""
	},
	"dependencies": {
		"@chakra-ui/react": "^2.6.1",
		"@emotion/react": "^11.11.0",
		"@emotion/styled": "^11.11.0",
		"@fontsource/heebo": "^5.3.0",
		"@hookform/resolvers": "^3.1.0",
		"@supabase/supabase-js": "^2.119.0",
		"@tanstack/query-sync-storage-persister": "5.107.1",
		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-query-persist-client": "5.107.1",
		"@vercel/analytics": "^1.0.1",
		"framer-motion": "^10.12.8",
		"lottie-react": "^2.4.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-hook-form": "^7.43.9",
		"react-icons": "^5.7.0",
		"react-router-dom": "^6.30.6",
		"zod": "^3.25.76",
		"zustand": "^4.5.5"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@playwright/test": "1.63.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.0.0",
		"eslint": "^9.39.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"globals": "^15.15.0",
		"prettier": "3.3.3",
		"supabase": "2.122.1",
		"typescript": "~5.6.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^4.3.1"
	},
	"type": "module"
}
